#!/bin/sh
# Blocks a push when any project rule fails. Installed by `./gradlew installGitHooks`
# (sets core.hooksPath to scripts/git-hooks). Emergency bypass: git push --no-verify
#
# Rules:
#   detekt                         static analysis + lti-design-system rules, every module that has it
#   verifyDesignSystemGuardrails   no raw colors/alpha/dp, no raw Material3 components in features
#   checkArchitecture              module dependency direction (feature -> domain <- data)

cd "$(git rev-parse --show-toplevel)" || exit 1

TASKS="detekt verifyDesignSystemGuardrails checkArchitecture"

echo "pre-push: checking project rules (./gradlew $TASKS)..."
if ./gradlew $TASKS --continue --console=plain -q; then
    echo "pre-push: all rules pass."
    exit 0
fi

echo ""
echo "pre-push: BLOCKED - a project rule failed (see the output above)."
echo "  Fix the findings, or format with detekt/ktlint, then push again."
echo "  Emergency only: git push --no-verify"
exit 1
